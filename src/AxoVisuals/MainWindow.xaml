<Window x:Class="AxoVisuals.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden" Background="#191B1E" RequestedTheme="Dark" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
<Grid.KeyboardAccelerators><KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="UndoAccelerator"/><KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="RedoAccelerator"/><KeyboardAccelerator Key="Z" Modifiers="Control,Shift" Invoked="RedoAccelerator"/></Grid.KeyboardAccelerators><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
<Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InspectorColumn" Width="300"/></Grid.ColumnDefinitions><Grid x:Name="TitleStrip" Grid.ColumnSpan="3" Background="#191B1E" SizeChanged="TitleSizeChanged"><TextBlock Text="AxoVisuals" Margin="16,0" FontSize="12" VerticalAlignment="Center"/><Grid x:Name="CaptionCircles" Width="138" HorizontalAlignment="Right" IsHitTestVisible="False"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Width="12" Height="12" Fill="#E7BC4D"/><Ellipse Grid.Column="1" Width="12" Height="12" Fill="#6ABC75"/><Ellipse Grid.Column="2" Width="12" Height="12" Fill="#D96B68"/></Grid></Grid>
<Border Grid.Row="1" Grid.RowSpan="2" Background="#202226" BorderBrush="#303338" BorderThickness="0,0,1,0"><StackPanel Padding="12,16" Spacing="18"><Button Content="Open image" Click="OpenClick" HorizontalAlignment="Stretch"/><TextBlock Text="WORKSPACE" FontSize="10" Foreground="#90969F" Margin="8,8,0,0"/><ListView x:Name="ToolList" SelectionChanged="ToolChanged" SelectedIndex="0"><ListViewItem Content="Image"/><ListViewItem Content="Resize"/><ListViewItem Content="Crop"/><ListViewItem Content="Rotate / Flip"/><ListViewItem Content="Adjustments"/><ListViewItem Content="Filters"/><ListViewItem Content="Convert / Compress"/><ListViewItem Content="Metadata"/><ListViewItem Content="Background"/><ListViewItem Content="Batch"/><ListViewItem Content="About"/></ListView></StackPanel></Border>
<Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Padding="20,0" BorderBrush="#303338" BorderThickness="0,0,0,1"><TextBlock MaxWidth="320" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" x:Name="FileNameText" Text="Workspace" VerticalAlignment="Center" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button x:Name="UndoButton" Content="Undo" Click="UndoClick" IsEnabled="False" VerticalAlignment="Center"/><Button x:Name="RedoButton" Content="Redo" Click="RedoClick" IsEnabled="False" VerticalAlignment="Center"/><Button Content="Hold original" PointerPressed="BeforePressed" PointerReleased="BeforeReleased" PointerExited="BeforeReleased" VerticalAlignment="Center"/><Button Content="Reset edits" Click="ResetClick" VerticalAlignment="Center"/><Button Content="Export…" Click="ExportClick" VerticalAlignment="Center"/></StackPanel></Grid>
<Grid Grid.Row="2" Grid.Column="1" Padding="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions><ScrollViewer x:Name="Viewport" ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"><Grid x:Name="ImageSurface"><Image x:Name="PreviewImage" Stretch="Fill"/><Canvas x:Name="CropOverlay" Background="Transparent" IsHitTestVisible="False" PointerPressed="CropPressed" PointerMoved="CropMoved" PointerReleased="CropReleased"><Rectangle x:Name="CropRectangle" Stroke="#8DD8C5" Fill="#228DD8C5" StrokeThickness="2" Visibility="Collapsed"/></Canvas></Grid></ScrollViewer><StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"><FontIcon Glyph="&#xEB9F;" FontSize="28" Foreground="#90969F"/><TextBlock Text="Drop an image here" FontSize="18" HorizontalAlignment="Center"/><Button Content="Open image" Click="OpenClick" HorizontalAlignment="Center"/><TextBlock Text="Images are processed locally." Foreground="#90969F" FontSize="12"/></StackPanel><Grid x:Name="BatchWorkspace" Background="#191B1E" Visibility="Collapsed"/><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8"><Button Content="Fit" Click="FitClick"/><Button Content="100%" Click="ActualClick"/><TextBlock x:Name="ZoomText" FontSize="12" VerticalAlignment="Center" Foreground="#90969F"/></StackPanel></Grid>
<Border x:Name="InspectorBorder" Grid.Row="2" Grid.Column="2" Background="#202226" BorderBrush="#303338" BorderThickness="1,0,0,0"><ScrollViewer><StackPanel x:Name="Inspector" Padding="20" Spacing="14"><TextBlock Text="IMAGE" FontSize="11" Foreground="#90969F"/><TextBlock x:Name="PropertiesText" Text="No image selected" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Border>
<ProgressBar x:Name="BusyProgress" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Top" IsIndeterminate="True" Visibility="Collapsed" Height="2"/><Border Grid.Row="3" Grid.ColumnSpan="3" Background="#202226" BorderBrush="#303338" BorderThickness="0,1,0,0"><Grid Padding="14,0"><TextBlock x:Name="StatusText" Text="Ready" FontSize="12" VerticalAlignment="Center"/></Grid></Border>
</Grid></Window>







